# Copy to frontend/.env. Only the public API URL goes here.
# NEVER put database credentials or Supabase service keys in frontend env files:
# every VITE_* variable is bundled into the JavaScript sent to the browser.
VITE_API_BASE_URL=http://localhost:8000

# Optional: show demo sign-in details on the login page (leave unset in production).
# Use a regular HR account (not admin): anyone who sees the login page can use it.
# VITE_DEMO_EMAIL=demo@example.com
# VITE_DEMO_PASSWORD=Demo1234
