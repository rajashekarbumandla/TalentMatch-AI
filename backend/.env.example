# Copy this file to backend/.env and fill in real values. Never commit backend/.env.

# --- Supabase PostgreSQL (required from Phase 2) ------------------------------
# Supabase dashboard -> your project -> "Connect" -> "Session pooler" connection string.
# Use the SESSION pooler (port 5432): it works over IPv4 (the direct connection is
# IPv6-only on the free tier) and supports the prepared statements psycopg uses.
# Change the scheme from "postgresql://" to "postgresql+psycopg://" for SQLAlchemy.
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# --- Login (required) -----------------------------------------------------------
# Long random secret that signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Keep it private (never commit it). Changing it logs every HR out.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
MIN_PASSWORD_LENGTH=8

# --- API ----------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ------------------------------------------------------------------
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_BATCH=50

# --- NLP ----------------------------------------------------------------------
# all-MiniLM-L6-v2 runs on ONNX Runtime; its files (~90 MB) are downloaded once into MODEL_CACHE_DIR.
MODEL_NAME=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
# MODEL_CACHE_DIR=C:\Users\you\.cache\talentmatch-models   (default; /tmp/... on Vercel)
# true: load the models when the API starts, so no request waits for them (default locally).
# false: load on first use (default on Vercel, and faster restarts while developing with --reload).
# On Vercel, leave this and MAX_FILE_SIZE_MB unset so the serverless defaults apply.
LOAD_MODEL_ON_STARTUP=true
# Semantic score calibration: cosine <= FLOOR -> 0, >= CEIL -> 100 (measured on the sample data).
SEMANTIC_COSINE_FLOOR=0.15
SEMANTIC_COSINE_CEIL=0.75

# --- Optional OCR for scanned PDFs (requires Tesseract installed separately) --
OCR_ENABLED=true
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Scoring weights (must sum to 1.0) ----------------------------------------
WEIGHT_SEMANTIC=0.40
WEIGHT_SKILLS=0.35
WEIGHT_EXPERIENCE=0.25
REQUIRED_SKILL_WEIGHT=2.0
PREFERRED_SKILL_WEIGHT=1.0
